// For format details, see https://aka.ms/devcontainer.json.
{
    "name": "Kiro Relay",

    // Use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
    "build": {
        // Path is relative to the devcontainer.json file.
        "dockerfile": "Dockerfile"
    },
    "workspaceFolder": "${localWorkspaceFolder}",
    "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",

    "features": {
        // More options: https://github.com/devcontainers/features/tree/main/src/docker-outside-of-docker#options
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
        // More options: https://github.com/devcontainers/features/tree/main/src/node#options
        "ghcr.io/devcontainers/features/node:2": {
            "version": "lts",
            "npmVersion": "latest"
        },
        // More options: https://github.com/devcontainers/features/tree/main
    },

    // Set environment variables for the remote container.
    "remoteEnv": {
        "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
    },

    // Use 'runArgs' to make an array of Docker CLI arguments that should be used when running the container.
    // "runArgs": [],

    // Use 'forwardPorts' to make a list of ports inside the container available locally.
    // "forwardPorts": [],
    
    // Use 'initializeCommand' to run commands locally before the container is created.
    // "initializeCommand": ".devcontainer/commands/initialize.sh",
    
    // Use 'postCreateCommand' to run commands after the container is created.
    "postCreateCommand": ".devcontainer/commands/post-create.sh",

    // Use 'postStartCommand' to run commands after the container is started.
    "postStartCommand": ".devcontainer/commands/post-start.sh",

    // "forwardPorts": [
    //     3000
    // ],
    // "portsAttributes": {
    //     "3000": {
    //         "label": "App",
    //         "onAutoForward": "openPreview"
    //     }
    // },
    
    // Configure tool-specific properties.
    "customizations": {
        "vscode": {
            "settings": {
              "kirorelay.cli.path": "/home/vscode/.local/bin/kiro-cli",
              "typescript.tsdk": "node_modules/typescript/lib"
            },
            // Add extensions to the container image.
            "extensions": [
                "ms-azuretools.vscode-docker",
                "cweijan.vscode-redis-client",
            ]
        }
    },
    
    // Change if need connect as root instead. More info: https://aka.ms/dev-containers-non-root.
    "remoteUser": "vscode"
}
