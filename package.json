{
  "name": "kiro-relay",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.1",
  "publisher": "viniciusclerod",
  "license": "MIT",
  "preview": true,
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/viniciusclerod/kiro-relay.git"
  },
  "bugs": {
    "url": "https://github.com/viniciusclerod/kiro-relay/issues"
  },
  "homepage": "https://github.com/viniciusclerod/kiro-relay#readme",
  "engines": {
    "vscode": "^1.104.0",
    "node": ">=22.18"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "language-models",
    "kiro",
    "kiro-cli",
    "chat",
    "model-provider",
    "copilot-chat",
    "byok",
    "aws"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "kirorelay.diagnose",
        "title": "%command.diagnose.title%",
        "category": "Kiro Relay"
      },
      {
        "command": "kirorelay.reloadCredentials",
        "title": "%command.reloadCredentials.title%",
        "category": "Kiro Relay"
      },
      {
        "command": "kirorelay.refreshModels",
        "title": "%command.refreshModels.title%",
        "category": "Kiro Relay"
      },
      {
        "command": "kirorelay.manage",
        "title": "%command.manage.title%",
        "category": "Kiro Relay"
      },
      {
        "command": "kirorelay.signIn",
        "title": "%command.signIn.title%",
        "category": "Kiro Relay"
      },
      {
        "command": "kirorelay.refreshUsage",
        "title": "%command.refreshUsage.title%",
        "category": "Kiro Relay"
      }
    ],
    "icons": {
      "kirorelay-kiro": {
        "description": "%icon.kiro.description%",
        "default": {
          "fontPath": "media/kirorelay-icons.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "configuration": {
      "title": "Kiro Relay",
      "properties": {
        "kirorelay.cli.path": {
          "type": "string",
          "default": "kiro-cli",
          "description": "%config.cli.path.description%",
          "scope": "machine"
        },
        "kirorelay.auth.sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "kiro-cli-db",
              "sso-cache"
            ]
          },
          "default": [
            "kiro-cli-db",
            "sso-cache"
          ],
          "description": "%config.auth.sources.description%"
        },
        "kirorelay.auth.databasePath": {
          "type": "string",
          "default": "",
          "description": "%config.auth.databasePath.description%"
        },
        "kirorelay.auth.ssoCachePath": {
          "type": "string",
          "default": "",
          "description": "%config.auth.ssoCachePath.description%"
        },
        "kirorelay.auth.refreshLeewaySeconds": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "%config.auth.refreshLeewaySeconds.description%"
        },
        "kirorelay.auth.renewCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "whoami"
          ],
          "scope": "machine",
          "description": "%config.auth.renewCommand.description%"
        },
        "kirorelay.reasoningEffort": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "none",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          },
          "markdownDescription": "%config.reasoningEffort.markdownDescription%"
        },
        "kirorelay.login.license": {
          "type": "string",
          "enum": [
            "",
            "pro",
            "free"
          ],
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.login.license.description%",
          "enumDescriptions": [
            "%config.login.license.ask%",
            "%config.login.license.pro%",
            "%config.login.license.free%"
          ]
        },
        "kirorelay.login.startUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "pattern": "^(https://\\S+)?$",
          "markdownDescription": "%config.login.startUrl.description%"
        },
        "kirorelay.login.region": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "pattern": "^([a-z]{2}(-[a-z]+)+-\\d+)?$",
          "markdownDescription": "%config.login.region.description%"
        },
        "kirorelay.login.deviceFlow": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "scope": "machine",
          "markdownDescription": "%config.login.deviceFlow.description%",
          "enumDescriptions": [
            "%config.login.deviceFlow.auto%",
            "%config.login.deviceFlow.always%",
            "%config.login.deviceFlow.never%"
          ]
        }
      }
    },
    "languageModelChatProviders": [
      {
        "vendor": "kirorelay",
        "displayName": "Kiro",
        "managementCommand": "kirorelay.manage"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "package": "vsce package",
    "check-name": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-name.ts",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^16.0.0",
    "ttf2woff": "^3.0.0",
    "typescript": "^5.8.0"
  },
  "l10n": "./l10n"
}
